# Neon development branch connection string (never the production branch).
# Pooled endpoint (host contains "-pooler") — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require"

# Same branch, direct/unpooled endpoint (same host without "-pooler").
# Used only by prisma migrate: PgBouncer breaks migration advisory locks.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
