  {
   "id": "plan_w_t",
   "type": "text",
   "x": 476,
   "y": 1090.0,
   "width": 723.84,
   "height": 180.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
