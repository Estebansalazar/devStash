  },
  {
   "id": "review_w_t",
   "type": "text",
   "x": 476,
   "y": 2894.0,
   "width": 690.5600000000001,
   "height": 200.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
